{
  "name": "near-sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous spot-trading agent whose risk limits are enforced on-chain and whose every decision can be replayed and verified.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:types": "vitest run --typecheck.only --passWithNoTests",
    "test:live": "LIVE=1 vitest run test/live",
    "check": "pnpm typecheck && pnpm test && pnpm test:types",
    "demo": "node src/cli.ts demo",
    "verify": "node src/cli.ts verify",
    "status": "node src/cli.ts status",
    "explorer": "node src/cli.ts explorer",
    "paper": "node src/cli.ts paper",
    "dashboard": "node src/cli.ts dashboard",
    "live": "node src/cli.ts live",
    "contract:build": "cd contracts/guardrail && cargo near build non-reproducible-wasm --no-abi",
    "contract:test": "cargo test --manifest-path contracts/guardrail/Cargo.toml",
    "contract:deploy": "node scripts/deploy-guardrail.ts"
  },
  "dependencies": {
    "canonicalize": "^5.1.0",
    "near-kit": "0.20.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
