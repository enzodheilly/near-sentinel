# Copy to .env and fill in. Never commit .env.
# 1Click partner JWT (https://partners.near-intents.org) — without it, quotes carry +0.25% fees.
ONECLICK_JWT=
# NEAR AI Cloud API key (https://cloud.near.ai)
NEARAI_API_KEY=

# NEAR network for the guardrail contract and the agent account: testnet or mainnet
NEAR_NETWORK=testnet
# On-chain guardrail, filled by scripts/setup-agent-key.ts.
# NEAR_AGENT_KEY can only call record_decision and pause on the guardrail; it cannot move funds.
NEAR_AGENT_ACCOUNT=
NEAR_GUARDRAIL_CONTRACT=
NEAR_AGENT_KEY=

# Live mode only (#47), filled by scripts/setup-live-key.ts: the key registered on intents.near that signs the
# agent's intents. It cannot move NEAR from the account, but it can trade/withdraw the agent's Intents balance.
AGENT_ACCOUNT=
AGENT_PRIVATE_KEY=
# Owner's hard cap per live trade, in USD
LIVE_MAX_NOTIONAL_USD=10
